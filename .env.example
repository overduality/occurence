# Occuring Environment Configuration

# Application Port
PORT=5555

# -------------------------------------------------------------
# AI Provider Configuration (Optional)
# -------------------------------------------------------------

# 1. 9Router Local AI Gateway (OpenAI Compatible)
# Defaults to 9Router on port 20128 with combo 'local'
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_MODEL=local
# OPENAI_API_KEY=9router

# 2. Google Gemini API Key
# GEMINI_API_KEY=

# 3. Official OpenAI API Key
# OPENAI_API_KEY=

# 4. Local Ollama Configuration (Direct)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
